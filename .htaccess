<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward Authorization Header for JWT Bearer Tokens in PHP
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

  # Block direct HTTP access to sensitive files and directories
  RewriteRule ^\.env.*$ - [F,L]
  RewriteRule ^backend/config/ - [F,L]
  RewriteRule ^backend/helpers/ - [F,L]
  RewriteRule ^backend/middleware/ - [F,L]
  RewriteRule ^\.git - [F,L]

  # Route /api/ requests to backend router
  RewriteRule ^api(/.*)?$ backend/router.php [QSA,L]

  # If requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Single Page Application (SPA) fallback - route all page requests to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Modern MIME Types
<IfModule mod_mime.c>
  AddType application/javascript js mjs
  AddType text/css css
  AddType image/svg+xml svg svgz
  AddType image/webp webp
  AddType font/woff2 woff2
</IfModule>

# Enable Gzip Compression for high-performance loading
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
